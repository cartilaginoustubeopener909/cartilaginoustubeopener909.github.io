		</main>

		<footer>
			<p>© Your Name</p>
		</footer>
		<script>
			const timeline = document.querySelector<HTMLElement>('.timeline-sections');

			if (timeline) {
				const spine = timeline.querySelector<HTMLElement>('.timeline-spine');
				const entries = Array.from(
					timeline.querySelectorAll<HTMLElement>('.experience-entry, .project-template'),
				);
				const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
				let scrollFrame = 0;

				const revealCompleteTimeline = () => {
					timeline.classList.remove('timeline-animated');
					timeline.style.removeProperty('--spine-fill');
					entries.forEach((entry) => entry.classList.add('timeline-entry--reached'));
				};

				const updateTimeline = () => {
					scrollFrame = 0;
					if (!spine || reducedMotion.matches) {
						revealCompleteTimeline();
						return;
					}

					const timelineRect = timeline.getBoundingClientRect();
					const spineRect = spine.getBoundingClientRect();
					const spineStart = spineRect.top - timelineRect.top;
					const guidePosition = window.innerHeight * 0.72;
					const fillHeight = Math.min(
						spine.offsetHeight,
						Math.max(0, guidePosition - spineRect.top),
					);

					timeline.style.setProperty('--spine-fill', `${fillHeight}px`);

					entries.forEach((entry) => {
						const entryRect = entry.getBoundingClientRect();
						const branchPoint = entryRect.top - timelineRect.top + entryRect.height / 2 - spineStart;
						entry.classList.toggle('timeline-entry--reached', fillHeight >= branchPoint);
					});
				};

				const requestTimelineUpdate = () => {
					if (scrollFrame) return;
					scrollFrame = window.requestAnimationFrame(updateTimeline);
				};

				const initializeTimeline = () => {
					if (reducedMotion.matches) {
						revealCompleteTimeline();
						return;
					}

					timeline.classList.add('timeline-animated');
					entries.forEach((entry) => entry.classList.remove('timeline-entry--reached'));
					updateTimeline();
				};

				window.addEventListener('scroll', requestTimelineUpdate, { passive: true });
				window.addEventListener('resize', requestTimelineUpdate);
				reducedMotion.addEventListener('change', initializeTimeline);
				new ResizeObserver(requestTimelineUpdate).observe(timeline);
				initializeTimeline();
			}
		</script>
	</body>
</html>
