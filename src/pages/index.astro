---
import SortingBackground from '../components/SortingBackground.astro';

const builtAt = new Date();
const builtAtLabel = new Intl.DateTimeFormat('en-GB', {
	day: '2-digit',
	month: 'short',
	year: 'numeric',
	hour: '2-digit',
	minute: '2-digit',
	hour12: false,
	timeZone: 'UTC',
}).format(builtAt);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="stylesheet" href="./styles.css" />
		<title>Portfolio</title>
	</head>
	<body>
		<SortingBackground />
		<header class="site-header">
			<nav class="site-nav" aria-label="Main navigation">
				<p class="site-build-time" title="Generated when this version of the portfolio was built">
					<span class="site-build-time__signal" aria-hidden="true"></span>
					<span>Last updated</span>
					<time datetime={builtAt.toISOString()}>{builtAtLabel} UTC</time>
				</p>
				<div class="site-nav__links">
					<a href="/">Home</a>
					<a href="#projects">Projects</a>
					<a href="#experience">Experience</a>
					<a href="#contact">Contact</a>
				</div>
				<a class="astro-badge" href="https://astro.build/" target="_blank" rel="noreferrer" aria-label="Built with Astro — visit astro.build">
					<svg viewBox="0 0 32 32" aria-hidden="true">
						<path class="astro-badge__body" d="M10.25 20.4 13.8 7.7c.25-.9.82-1.35 1.7-1.35h1c.88 0 1.45.45 1.7 1.35l3.55 12.7-3.2-1.85-1.35-4.6h-2.4l-1.35 4.6-3.2 1.85Z"/>
						<path class="astro-badge__flare" d="M8.6 19.45c1.55 1.2 3.35 2.05 5.3 2.5-.92.66-1.55 1.68-1.72 2.82-.08.5-.05 1 .08 1.48-1.88-1.08-3.23-2.9-3.66-5.02-.12-.6-.12-1.2 0-1.78Zm14.8 0c.12.58.12 1.18 0 1.78-.43 2.12-1.78 3.94-3.66 5.02.13-.48.16-.98.08-1.48-.17-1.14-.8-2.16-1.72-2.82 1.95-.45 3.75-1.3 5.3-2.5Z"/>
					</svg>
					<span>Built with <strong>Astro</strong></span>
				</a>
			</nav>
		</header>

		<main>
			<section id="hero" aria-labelledby="hero-title">
				<article class="hero-card">
					<header>
