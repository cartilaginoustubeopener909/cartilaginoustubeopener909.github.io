---
import { projects } from '../../data/projects';

export function getStaticPaths() {
	return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{project.title} | Portfolio</title>
	</head>
	<body>
		<header><nav aria-label="Main navigation"><a href="/">Home</a><a href="/projects">Projects</a></nav></header>
		<main>
			<article>
				<header><p>Project</p><h1>{project.title}</h1><p>{project.summary}</p></header>
				<section aria-labelledby="overview-title"><h2 id="overview-title">Overview</h2><p>Project overview to be added.</p></section>
				<section aria-labelledby="role-title"><h2 id="role-title">My Role</h2><p>Role and responsibilities to be added.</p></section>
				<section aria-labelledby="challenge-title"><h2 id="challenge-title">Challenge</h2><p>Challenge to be added.</p></section>
				<section aria-labelledby="solution-title"><h2 id="solution-title">Solution</h2><p>Approach and implementation to be added.</p></section>
				<section aria-labelledby="outcome-title"><h2 id="outcome-title">Outcome</h2><p>Results and learnings to be added.</p></section>
				<section aria-labelledby="technology-title"><h2 id="technology-title">Technology</h2><ul><li>Technologies to be added.</li></ul></section>
			</article>
			<p><a href="/projects">Back to projects</a></p>
		</main>
		<footer><p>© Your Name</p></footer>
	</body>
</html>
