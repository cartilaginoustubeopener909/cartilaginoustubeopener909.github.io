{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Astro dev server",
      "type": "process",
      "command": "${workspaceFolder}\\node_modules\\.bin\\astro.cmd",
      "args": [
        "dev",
        "--background"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Stop Astro dev server",
      "type": "process",
      "command": "${workspaceFolder}\\node_modules\\.bin\\astro.cmd",
      "args": [
        "dev",
        "stop"
      ],
      "problemMatcher": []
    }
  ]
}
